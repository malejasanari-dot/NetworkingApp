{
  "expo": {
    "name": "NetworkingApp",
    "slug": "networking-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconolhh.png",
    "scheme": "networkingapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/iconolhh.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.personalnetworkingapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/iconolhh.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/iconolhh.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28a4c1f5-c940-437d-8f0e-f80fe9106eff"
      }
    },
    "owner": "malejasans-organization"
  }
}
