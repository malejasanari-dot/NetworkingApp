{
  "expo": {
    "name": "My Networking App",
    "slug": "app-my-networking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/iconolhh.png",
    "scheme": "personalnetworkingapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/iconolhh.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.personalnetworkingapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/iconolhh.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/iconolhh.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44cb32f7-8373-4829-a585-20eaff9f58d8"
      }
    },
    "owner": "malejasans-organization"
  }
}
