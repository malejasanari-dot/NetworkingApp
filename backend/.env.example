# Configuración del servidor
PORT=3000

# Base de datos MySQL Empresarial (Variables de ejemplo - NO poner credenciales reales aquí)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario_ejemplo
DB_PASSWORD=
DB_NAME=nombre_bd_ejemplo

# Autenticación Supabase (Para validar tokens de sesión JWT del frontend)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anonima-publica

# Protección de frecuencia (Rate Limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Orígenes permitidos para CORS (separados por comas para producción web, ej: https://mi-app.com,https://admin.mi-app.com)
# Peticiones sin encabezado Origin (móviles nativas Android/iOS, curl, healthchecks) se permiten automáticamente.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
